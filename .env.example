# Non-secret local overrides only. Aspire generates PostgreSQL credentials at runtime.
ASPNETCORE_ENVIRONMENT=Development
DecisionForge__Platform__ApplicationName=DecisionForge.Api
DecisionForge__Platform__CorrelationHeaderName=X-Correlation-ID
DecisionForge__Identity__Seeding__SeedRolesOnStartup=false
DecisionForge__Identity__Seeding__Demo__Enabled=false

# Optional: set by Aspire automatically when its dashboard collector is active.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Never commit passwords, connection strings, cookies or API keys to this file.
# When demo seeding is explicitly enabled in Development/Demo, supply
# DecisionForge__Identity__Seeding__Demo__Password through user-secrets or the
# process environment, never by adding a value to this file.
